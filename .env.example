############################################################
# COMPOSE FILE SELECTION
############################################################
COMPOSE_FILE=docker-compose.yml


############################################################
# SECRETS — YOU MUST CHANGE EVERY VALUE BELOW!
#
# Run this to auto-generate all secrets:
#   bash scripts/generate-secrets.sh
#
# NEVER commit the real .env file to Git!
############################################################

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_use_generate-secrets.sh

# ─── JWT (Legacy HS256 symmetric key — min 32 chars) ──────
JWT_SECRET=CHANGE_ME_use_generate-secrets.sh
# Pre-generated JWT tokens signed with the above secret.
# Re-generate with: bash scripts/generate-secrets.sh
ANON_KEY=CHANGE_ME_use_generate-secrets.sh
SERVICE_ROLE_KEY=CHANGE_ME_use_generate-secrets.sh

# ─── Asymmetric keys (ES256 — optional, leave blank to use HS256 only) ───
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ─── Studio Dashboard Login ────────────────────────────────
DASHBOARD_USERNAME=supabase
# Set a strong password here
DASHBOARD_PASSWORD=Krishna@4809

# ─── Encryption Keys ──────────────────────────────────────
# min 64 chars (generate: openssl rand -base64 48)
SECRET_KEY_BASE=CHANGE_ME_use_generate-secrets.sh

# exactly 16 chars (generate: openssl rand -hex 8)
REALTIME_DB_ENC_KEY=CHANGE_ME_16char

# exactly 32 chars (generate: openssl rand -hex 16)
VAULT_ENC_KEY=CHANGE_ME_32character_key_here!!

# min 32 chars (generate: openssl rand -base64 24)
PG_META_CRYPTO_KEY=CHANGE_ME_use_generate-secrets.sh

# ─── Logflare / Analytics tokens ─────────────────────────
# min 32 chars (generate: openssl rand -base64 24)
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME_use_generate-secrets.sh
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME_use_generate-secrets.sh

# ─── S3-compatible Storage keys ──────────────────────────
# Access key (generate: openssl rand -hex 16)
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME_use_generate-secrets.sh
# Secret (generate: openssl rand -hex 32)
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME_use_generate-secrets.sh


############################################################
# URLs — Update with your actual domain
############################################################

# Public URL of the Supabase API (what browsers/apps connect to)
# This is the api.aaryavtech.online subdomain
SUPABASE_PUBLIC_URL=https://api.aaryavtech.online

# Full external URL of Auth service (used for OAuth callbacks, email links)
API_EXTERNAL_URL=https://api.aaryavtech.online/auth/v1


############################################################
# Database — Postgres
############################################################

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############################################################
# Auth / GoTrue Settings
############################################################

# The URL users are sent to after email confirmation / password reset
# Set this to your main application URL
SITE_URL=https://supabase.aaryavtech.online

# Comma-separated list of additional allowed redirect URLs (OAuth, email links)
ADDITIONAL_REDIRECT_URLS=https://supabase.aaryavtech.online,https://api.aaryavtech.online

# Set to true to disable new user registrations
DISABLE_SIGNUP=false

# JWT token expiry in seconds (3600 = 1 hour)
JWT_EXPIRY=3600

# Anonymous users (Supabase feature — set to false to disable)
ENABLE_ANONYMOUS_USERS=false

# Email settings
ENABLE_EMAIL_SIGNUP=true

# Set to true to skip email confirmation (useful while testing SMTP)
# Set to false once SMTP is confirmed working
ENABLE_EMAIL_AUTOCONFIRM=true


############################################################
# SMTP — Hostinger Business Email
#
# How to configure:
# 1. Log in to Hostinger hPanel
# 2. Go to Email → Email Accounts
# 3. Note your email address and password
# 4. Use the SMTP settings below (Hostinger standard)
#
# Hostinger SMTP settings:
#   Host: smtp.hostinger.com
#   Port: 587 (STARTTLS) or 465 (SSL)
#   User: your-business-email@aaryavtech.online
#   Pass: your Hostinger email password
#
# Once confirmed working, set ENABLE_EMAIL_AUTOCONFIRM=false
############################################################

SMTP_ADMIN_EMAIL=noreply@aaryavtech.online
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@aaryavtech.online
SMTP_PASS=CHANGE_ME_your_hostinger_email_password
SMTP_SENDER_NAME=Supabase - aaryavtech

# Auth email URL paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify


############################################################
# Studio defaults
############################################################

STUDIO_DEFAULT_ORGANIZATION=aaryavtech
STUDIO_DEFAULT_PROJECT=Production

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############################################################
# Edge Functions
############################################################

FUNCTIONS_VERIFY_JWT=false
